// ACTIVITY 1: POINTER ARITHMETIC (C VERSION)
#include <stdio.h>

int main() {
    int numbers[5] = {10, 20, 30, 40, 50};

    // Array name decays to a pointer to its first element
    int *ptr = numbers;

    printf("Array elements accessed via pointer arithmetic:\n");
    for (int i = 0; i < 5; i++) {
        printf("Value: %d\n", *ptr);  // dereference
        ptr++;                        // move to the next int
    }

    // Reset the pointer to the start
    ptr = numbers;

    printf("\nAccessing using offset arithmetic:\n");
    for (int i = 0; i < 5; i++) {
        printf("Index %d has value: %d\n", i, *(ptr + i));
    }

    return 0;
}