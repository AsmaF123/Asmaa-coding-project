// ACTIVITY 1: SIMULATING INHERITANCE IN C
#include <stdio.h>
#include <string.h>

// BASE STRUCT (Parent)
struct Shape {
    char color[20];
};

// DERIVED STRUCT (Child)
struct Circle {
    struct Shape base;   // base struct as the FIRST member
    double radius;
};

int main() {
    struct Circle myCircle;

    // Initialise the "inherited" data through 'base'
    strcpy(myCircle.base.color, "Red");

    // Initialise the Circle's own data
    myCircle.radius = 5.0;

    printf("Circle Color (Inherited): %s\n", myCircle.base.color);
    printf("Circle Radius (Specific): %.2f\n", myCircle.radius);

    return 0;
}s